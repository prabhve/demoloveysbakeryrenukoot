# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive storefront map and directions.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional Razorpay credentials for server-side order creation and signature verification.
# Keep online payment disabled in Business Settings until valid keys are configured.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ADMIN_OWNER_PASSWORD: Optional server-configured master password (minimum 12 characters) for the principal owner account (prabhve5@gmail.com).
# If left empty, the first-run owner password claim screen on /admin/login allows setting the initial password securely.
ADMIN_OWNER_PASSWORD=

