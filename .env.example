# ==============================================================================
# LOVEY'S BAKERY & PIZZA CORNERS — CLEAN ENVIRONMENT CONFIGURATION
# ==============================================================================
# Only genuinely required or optional platform variables are listed below.
# Manual UPI QR advance payments and password-only admin authentication run natively.
# ==============================================================================

# ------------------------------------------------------------------------------
# A. REQUIRED (SUPABASE / DATABASE & AUTHENTICATION)
# ------------------------------------------------------------------------------
# Public Supabase project URL and publishable client key for database, auth, and storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# B. OPTIONAL (CANONICAL SITE / DEPLOYMENT URL)
# ------------------------------------------------------------------------------
# Canonical public URL used for SEO sitemap.xml, robots.txt, and recovery links.
NEXT_PUBLIC_SITE_URL=
APP_URL=

# ------------------------------------------------------------------------------
# C. CONDITIONAL SERVER-ONLY (PRIVILEGED STAFF AUTH ADMINISTRATION)
# ------------------------------------------------------------------------------
# Never expose to the browser and never prefix with NEXT_PUBLIC_ or VITE_.
INITIAL_OWNER_TEMP_PASSWORD=
# SUPABASE_SECRET_KEY=
